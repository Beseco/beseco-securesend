# ── SecureSend Cloud — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (Produktion via docker-compose — Passwort unten setzen):
# DATABASE_URL wird automatisch aus POSTGRES_PASSWORD in docker-compose gesetzt.
# Nur überschreiben wenn eine externe Datenbank verwendet wird:
# DATABASE_URL=postgresql+asyncpg://securesend:changeme@localhost:5432/securesend

# PostgreSQL-Passwort (wird von docker-compose für den DB-Container verwendet)
POSTGRES_PASSWORD=changeme_bitte_aendern

# ── Sicherheit ─────────────────────────────────────────────────────────────────
# Starken Schlüssel generieren: openssl rand -hex 32
SECRET_KEY=change-me-in-production-min-32-zeichen

# Cookies nur über HTTPS senden (true in Produktion, false für lokale Entwicklung)
SECURE_COOKIES=true

# Erlaubte CORS-Origins (kommagetrennt, keine Leerzeichen)
ALLOWED_ORIGINS=https://deine-domain.de

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Öffentliche URL ───────────────────────────────────────────────────────────
# Wird in E-Mails (Links, Tracking-Pixel) verwendet.
# Leer lassen → wird automatisch aus der Anfrage-URL abgeleitet.
PUBLIC_BASE_URL=https://deine-domain.de

# ── ClamAV Virenscanner ───────────────────────────────────────────────────────
# false = Upload ablehnen wenn ClamAV nicht erreichbar (empfohlen für Produktion)
# true  = Upload trotzdem erlauben wenn ClamAV offline (nur für Entwicklung)
CLAMAV_FAIL_OPEN=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Datei-Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
