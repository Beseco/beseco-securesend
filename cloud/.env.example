# ── SecureSend Cloud — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./securesend.db

# PostgreSQL (prod) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://securesend:changeme@localhost:5432/securesend

# PostgreSQL credentials (used by docker-compose to init the DB container)
POSTGRES_DB=securesend
POSTGRES_USER=securesend
POSTGRES_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8000

# Öffentliche Basis-URL — wird in Bestätigungs-E-Mails verwendet
# Beispiel: https://securesend.deine-domain.de
# Leer lassen → wird automatisch aus der Anfrage-URL abgeleitet (funktioniert hinter nginx)
PUBLIC_BASE_URL=
